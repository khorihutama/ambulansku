# AI - OpenRouter (supports multiple providers)
OPENROUTER_API_KEY=your_openrouter_key
AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=https://openrouter.ai/api/v1
# LLM timeout in milliseconds; 0 disables it.
AI_TIMEOUT_MS=20000

# Google Maps (server-side for Places API)
GOOGLE_MAPS_API_KEY=your_google_maps_key
# Places timeout in milliseconds; 0 disables it.
PLACES_TIMEOUT_MS=8000
# Google Maps (client-side for Maps JS)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Penilaian (Judging) — set to "true" to enable the /penilaian page
PENILAIAN_ENABLED=true

# Triage session token signing secret (min 32 chars). Development falls back
# to an insecure constant; production requires this value.
TRIAGE_SESSION_SECRET=
# Optional comma-separated origins allowed to call the API cross-origin.
# Same-origin requests work without it.
ALLOWED_ORIGINS=
# Number of trusted proxy hops in front of the app. Render uses 1.
TRUSTED_PROXY_HOPS=1
# Global triage budget per hour across all sessions and IPs.
TRIAGE_GLOBAL_MAX=60